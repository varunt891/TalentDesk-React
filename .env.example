DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/talentdesk?schema=public"
JWT_SECRET="replace-this-with-a-long-random-secret"
CLIENT_ORIGIN="http://localhost:5173"
CLIENT_ORIGINS="http://localhost:5173,https://your-vercel-app.vercel.app"
VITE_API_URL="http://localhost:4000/api"
PORT=4000
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_FALLBACK_MODELS="llama-3.1-8b-instant"
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_FALLBACK_MODELS="gemini-3.5-flash,gemini-flash-latest"
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_MODEL="openai/gpt-oss-120b"
OPENROUTER_FALLBACK_MODELS="google/gemini-3.5-flash-lite,deepseek/deepseek-r1,qwen/qwen-2.5-72b-instruct,mistralai/mistral-small-3.2-24b-instruct"
MISTRAL_API_KEY="your-mistral-api-key"
MISTRAL_MODEL="mistral-small-latest"
MISTRAL_FALLBACK_MODELS="ministral-8b-latest"

# Cloudflare R2 (resume file storage) — see server/src/services/storageService.js
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="talentdesk-resumes"
